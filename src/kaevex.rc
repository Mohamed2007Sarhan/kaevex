// Resource script for Kaevex Security Platform
#define WIN32_LEAN_AND_MEAN
#include <windows.h>

// Manifest for Common Controls v6 and Per-Monitor V2 DPI awareness
1 24 "src\\kaevex.manifest"

// Application Icon (Resource ID 1 is standard default icon for Windows Explorer)
1 ICON "assets\\icon.ico"
2 ICON "assets\\icon.ico"

// World Map Bitmap
101 BITMAP "assets\\world_map_cyber.bmp"

// Auth Dialog Hologram Shield Bitmap
102 BITMAP "assets\\auth_hologram.bmp"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Kaevex Security"
            VALUE "FileDescription",  "Kaevex Security Platform v1.0 [SOC Enterprise]"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "kaevex"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Kaevex Security"
            VALUE "OriginalFilename", "kaevex.exe"
            VALUE "ProductName",      "Kaevex Security Platform"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
